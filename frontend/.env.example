# Relative /api uses Vite's development proxy. Use an HTTPS API URL or a same-origin
# production reverse proxy. This public variable must never contain credentials.
VITE_API_URL=/api

# Only for the guarded Vercel staging build. Public origin pins, never credentials.
# STAGING_RENDER_ORIGIN=<exact-https-staging-render-origin>
# STAGING_FRONTEND_ORIGIN=<exact-https-staging-vercel-origin>
