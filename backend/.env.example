NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pooled runtime connection; direct connection for Prisma migrations.
# Fill these locally or in the appropriate hosting environment. Never commit secrets.
DATABASE_URL=
DIRECT_URL=

# Run npm run auth:setup locally; never put the plaintext password in this file.
SHARED_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SAME_SITE=lax
# Trust only the verified proxy path; never enable arbitrary forwarded IP headers.
TRUST_PROXY_HOPS=0

# Migration deploy is an explicit operator action, never a build/start action.
# Set these only after verifying the target in Neon and reviewing a tested backup.
# MIGRATION_TARGET=development
# MIGRATION_EXPECTED_HOST=<exact-direct-endpoint-host>
# MIGRATION_EXPECTED_DATABASE=<exact-database-name>
# MIGRATION_APPROVED=yes

# Backup configuration is separate from runtime connections; see docs/backup-restore.md.
# Never set disposable PostgreSQL test variables to an existing Neon database.
